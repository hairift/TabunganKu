<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warna_latar">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/gulir_beranda"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/jarak_lg"
            android:paddingTop="@dimen/jarak_lg">

            <!-- Tajuk merek dengan logo resmi TabunganKu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/ket_akses_logo"
                    android:src="@drawable/ic_logo_tabunganku" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/jarak_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/teks_judul"
                        android:text="@string/nama_aplikasi"
                        android:textColor="@color/warna_teks_utama"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/beranda_judul_buku"
                        android:textColor="@color/warna_teks_sekunder"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Kartu ringkasan saldo keseluruhan (titik fokus utama Beranda) -->
            <LinearLayout
                android:id="@+id/kartu_ringkasan_utama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_lg"
                android:background="@drawable/latar_kartu_ringkasan"
                android:orientation="vertical"
                android:padding="@dimen/jarak_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/beranda_label_total_terkumpul"
                    android:textColor="@color/warna_kartu_hero_sekunder"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/teks_total_terkumpul_hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/teks_judul"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/warna_kartu_hero_teks"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/teks_dari_target_hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/warna_kartu_hero_sekunder"
                    android:textSize="13sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progres_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jarak_md"
                    android:max="100"
                    app:indicatorColor="@color/warna_kartu_hero_isi"
                    app:trackColor="@color/warna_kartu_hero_jalur"
                    app:trackCornerRadius="5dp"
                    app:trackThickness="9dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jarak_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/teks_jumlah_target_hero"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/warna_kartu_hero_teks"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/teks_persen_hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_bold"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/warna_kartu_hero_teks"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Kelompok cari dan saring, disembunyikan saat belum ada target sama sekali -->
            <LinearLayout
                android:id="@+id/kelompok_cari_dan_saring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Kolom pencarian target -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/wadah_cari_target"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jarak_lg"
                    app:boxBackgroundColor="@color/warna_permukaan"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_tombol"
                    app:boxCornerRadiusBottomStart="@dimen/radius_tombol"
                    app:boxCornerRadiusTopEnd="@dimen/radius_tombol"
                    app:boxCornerRadiusTopStart="@dimen/radius_tombol"
                    app:boxStrokeColor="@color/warna_garis_batas"
                    app:endIconMode="clear_text"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_cari"
                    app:startIconTint="@color/warna_teks_sekunder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_cari_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/beranda_cari_petunjuk"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="@dimen/sentuh_minimum"
                        android:textColor="@color/warna_teks_utama"
                        android:textColorHint="@color/warna_teks_sekunder"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Penyaring status & kategori -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jarak_sm"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/grup_chip_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/jarak_sm"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_status_semua"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minHeight="@dimen/sentuh_minimum"
                            android:text="@string/filter_semua" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_status_berjalan"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/sentuh_minimum"
                            android:text="@string/filter_berjalan" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_status_tercapai"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/sentuh_minimum"
                            android:text="@string/filter_tercapai" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_status_arsip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/sentuh_minimum"
                            android:text="@string/filter_diarsipkan" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/grup_chip_kategori"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/jarak_sm"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Keadaan memuat (R-27) -->
            <LinearLayout
                android:id="@+id/tata_memuat_beranda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_xxl"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/jarak_xl"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/warna_primer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/jarak_md"
                    android:gravity="center"
                    android:text="@string/keadaan_memuat_target"
                    android:textColor="@color/warna_teks_sekunder"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Keadaan kosong / hasil saring kosong (R-27) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tata_kosong_beranda"
                style="@style/GayaKartu.Utama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_lg"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/jarak_xxl">

                    <ImageView
                        android:layout_width="140dp"
                        android:layout_height="84dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_foto_kosong" />

                    <TextView
                        android:id="@+id/teks_kosong_judul"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_md"
                        android:fontFamily="@font/teks_judul"
                        android:gravity="center"
                        android:text="@string/keadaan_kosong_judul"
                        android:textColor="@color/warna_teks_utama"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/teks_kosong_isi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_sm"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/keadaan_kosong_isi"
                        android:textColor="@color/warna_teks_sekunder"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombol_aksi_kosong"
                        style="@style/GayaTombol.Aksen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_lg"
                        android:text="@string/keadaan_kosong_aksi" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Keadaan galat (R-27) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tata_galat_beranda"
                style="@style/GayaKartu.Utama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_lg"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/jarak_xl">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_peringatan"
                        app:tint="@color/warna_galat_teks" />

                    <TextView
                        android:id="@+id/teks_galat_beranda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_sm"
                        android:gravity="center"
                        android:text="@string/keadaan_galat_judul"
                        android:textColor="@color/warna_teks_utama"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombol_muat_ulang_beranda"
                        style="@style/GayaTombol.Garis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_md"
                        android:text="@string/keadaan_galat_aksi" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daftar kartu target tabungan -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/daftar_target_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_sm"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/tombol_tambah_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/jarak_lg"
        android:backgroundTint="@color/warna_aksen"
        android:contentDescription="@string/beranda_tombol_target_baru"
        android:fontFamily="@font/plus_jakarta_semibold"
        android:minHeight="@dimen/sentuh_minimum"
        android:text="@string/beranda_tombol_target_baru"
        android:textColor="@color/warna_teks_di_aksen"
        app:icon="@drawable/ic_tambah"
        app:iconTint="@color/warna_teks_di_aksen" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
