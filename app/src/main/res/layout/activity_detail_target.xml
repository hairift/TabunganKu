<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warna_latar"
    android:orientation="vertical">

    <!-- Bilah atas dengan tombol kembali & menu lainnya -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warna_permukaan"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/jarak_sm"
        android:paddingVertical="@dimen/jarak_sm">

        <ImageButton
            android:id="@+id/tombol_kembali_detail"
            android:layout_width="@dimen/sentuh_minimum"
            android:layout_height="@dimen/sentuh_minimum"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ket_akses_kembali"
            android:padding="12dp"
            android:src="@drawable/ic_kembali"
            app:tint="@color/warna_teks_utama" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/jarak_sm"
            android:layout_weight="1"
            android:fontFamily="@font/teks_judul"
            android:text="@string/detail_judul_default"
            android:textColor="@color/warna_teks_utama"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/tombol_menu_detail"
            android:layout_width="@dimen/sentuh_minimum"
            android:layout_height="@dimen/sentuh_minimum"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_menu_ubah"
            android:padding="12dp"
            android:src="@drawable/ic_lainnya_menu"
            app:tint="@color/warna_teks_utama" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/warna_garis_halus" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/jarak_lg">

            <!-- Kartu foto motivasi impian (ketuk untuk memperbesar) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/GayaKartu.Utama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp">

                    <ImageView
                        android:id="@+id/foto_motivasi_detail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:contentDescription="@string/label_foto_motivasi"
                        android:focusable="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_foto_kosong" />

                    <TextView
                        android:id="@+id/teks_kategori_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="@dimen/jarak_md"
                        android:background="@drawable/latar_foto_scrim"
                        android:fontFamily="@font/plus_jakarta_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textColor="@color/warna_teks_di_scrim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/teks_status_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/jarak_md"
                        android:background="@drawable/latar_foto_scrim"
                        android:fontFamily="@font/plus_jakarta_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textColor="@color/warna_teks_di_scrim"
                        android:textSize="12sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kartu progres & metrik utama -->
            <com.google.android.material.card.MaterialCardView
                style="@style/GayaKartu.Utama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/jarak_lg">

                    <TextView
                        android:id="@+id/teks_nama_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/teks_judul"
                        android:textColor="@color/warna_teks_utama"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/teks_catatan_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/warna_teks_sekunder"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_md"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/teks_saldo_detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/teks_judul"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/warna_teks_utama"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/teks_persen_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_bold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/warna_primer"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progres_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_sm"
                        android:max="100"
                        app:indicatorColor="@color/warna_primer"
                        app:trackColor="@color/warna_permukaan_sekunder"
                        app:trackCornerRadius="5dp"
                        app:trackThickness="10dp" />

                    <!-- Tiga metrik sejajar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_md"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_label_target"
                                android:textColor="@color/warna_teks_sekunder"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/teks_target_nominal_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_semibold"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/warna_teks_utama"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_label_sisa"
                                android:textColor="@color/warna_teks_sekunder"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/teks_sisa_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_semibold"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/warna_teks_utama"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rekomendasi nabung -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/jarak_md"
                        android:background="@color/warna_permukaan_sekunder"
                        android:orientation="vertical"
                        android:padding="@dimen/jarak_md">

                        <TextView
                            android:id="@+id/teks_tenggat_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_semibold"
                            android:textColor="@color/warna_teks_utama"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/teks_rekomendasi_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/warna_teks_sekunder"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol aksi setor dan tarik -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_md"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_setor_detail"
                    style="@style/GayaTombol.Aksen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detail_tombol_setor"
                    app:icon="@drawable/ic_setor"
                    app:iconTint="@color/warna_teks_di_aksen" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_tarik_detail"
                    style="@style/GayaTombol.Garis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/jarak_sm"
                    android:layout_weight="1"
                    android:text="@string/detail_tombol_tarik"
                    app:icon="@drawable/ic_tarik"
                    app:iconTint="@color/warna_aksen" />
            </LinearLayout>

            <!-- Bagian Riwayat Transaksi Target -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_xl"
                android:fontFamily="@font/plus_jakarta_bold"
                android:text="@string/detail_label_riwayat"
                android:textColor="@color/warna_teks_utama"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/teks_riwayat_target_kosong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_sm"
                android:background="@color/warna_permukaan"
                android:padding="@dimen/jarak_lg"
                android:text="@string/detail_riwayat_kosong"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/daftar_transaksi_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jarak_sm"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
